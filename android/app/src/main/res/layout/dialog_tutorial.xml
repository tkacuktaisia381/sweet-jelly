<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/space_md">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tutorial_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/cream_50"
        app:cardCornerRadius="@dimen/card_radius_md"
        app:cardElevation="18dp"
        app:strokeColor="@color/sheet_stroke"
        app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_lg"
            android:paddingTop="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:paddingBottom="@dimen/space_md">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/dialog_tutorial_title"
                android:textAppearance="@style/TextAppearance.App.Section"
                android:textColor="@color/ink" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:text="@string/tutorial_step_1"
                    android:textAppearance="@style/TextAppearance.App.Label"
                    android:textColor="@color/jelly_pink_deep" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tutorial_rule_1"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/ink_muted" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:text="@string/tutorial_step_2"
                    android:textAppearance="@style/TextAppearance.App.Label"
                    android:textColor="@color/jelly_pink_deep" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tutorial_rule_2"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/ink_muted" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:text="@string/tutorial_step_3"
                    android:textAppearance="@style/TextAppearance.App.Label"
                    android:textColor="@color/jelly_pink_deep" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tutorial_rule_3"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/ink_muted" />

            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/tutorial_gem"
                android:layout_marginTop="@dimen/space_md">

                <ImageView
                    android:id="@+id/tutorial_gem_left"
                    android:layout_width="@dimen/tutorial_gem"
                    android:layout_height="@dimen/tutorial_gem"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sprite_gem_pink"
                    android:translationX="-28dp" />

                <ImageView
                    android:id="@+id/tutorial_gem_right"
                    android:layout_width="@dimen/tutorial_gem"
                    android:layout_height="@dimen/tutorial_gem"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sprite_gem_mint"
                    android:translationX="28dp" />

            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:text="@string/tutorial_caption"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/ink_faint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_tutorial_close"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_secondary_h"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/tutorial_got_it" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>
