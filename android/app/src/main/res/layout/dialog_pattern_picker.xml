<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/space_md">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/picker_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/cream_50"
        app:cardCornerRadius="@dimen/card_radius_md"
        app:cardElevation="18dp"
        app:strokeColor="@color/sheet_stroke"
        app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_lg"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="@dimen/space_md">

            <TextView
                android:id="@+id/txt_picker_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/dialog_patterns_title"
                android:textAppearance="@style/TextAppearance.App.Section"
                android:textColor="@color/ink" />

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginTop="@dimen/space_md"
                android:fillViewport="true">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/picker_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </androidx.core.widget.NestedScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_picker_close"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_secondary_h"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/dialog_close" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>
