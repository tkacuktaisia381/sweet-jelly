<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_xxs"
    android:minHeight="@dimen/icon_btn"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/card_radius_sm"
    app:cardElevation="4dp"
    app:strokeColor="@color/sheet_stroke"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_xs">

        <FrameLayout
            android:layout_width="@dimen/pattern_preview"
            android:layout_height="@dimen/pattern_preview">

            <ImageView
                android:id="@+id/pattern_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/sprite_window_frame" />

            <View
                android:id="@+id/pattern_dot"
                android:layout_width="@dimen/goal_dot"
                android:layout_height="@dimen/goal_dot"
                android:layout_gravity="center"
                android:background="@drawable/bg_dot"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/pattern_lock"
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lock" />

        </FrameLayout>

        <TextView
            android:id="@+id/pattern_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:textColor="@color/ink" />

        <LinearLayout
            android:id="@+id/pattern_stars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/pattern_star_one"
                android:layout_width="@dimen/pattern_star"
                android:layout_height="@dimen/pattern_star"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/sprite_star" />

            <ImageView
                android:id="@+id/pattern_star_two"
                android:layout_width="@dimen/pattern_star"
                android:layout_height="@dimen/pattern_star"
                android:layout_marginStart="2dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/sprite_star" />

            <ImageView
                android:id="@+id/pattern_star_three"
                android:layout_width="@dimen/pattern_star"
                android:layout_height="@dimen/pattern_star"
                android:layout_marginStart="2dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/sprite_star" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
