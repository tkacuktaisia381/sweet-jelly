<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/stat_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/card_radius_sm"
        app:cardElevation="6dp"
        app:strokeColor="@color/sheet_stroke"
        app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_xs"
            android:paddingTop="@dimen/space_sm"
            android:paddingEnd="@dimen/space_xs"
            android:paddingBottom="@dimen/space_sm">

            <View
                android:id="@+id/stat_dot"
                android:layout_width="@dimen/stat_dot"
                android:layout_height="@dimen/stat_dot"
                android:background="@drawable/bg_dot"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/stat_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Numeral"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/stat_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/ink_faint" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</merge>
