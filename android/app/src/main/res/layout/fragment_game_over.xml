<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_result_gradient">

    <ImageView
        android:id="@+id/img_result_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.25"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/img_result_blob"
        android:layout_width="@dimen/blob_md"
        android:layout_height="@dimen/blob_md"
        android:alpha="0.18"
        android:importantForAccessibility="no"
        android:src="@drawable/blob_pink"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.08"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.06" />

    <FrameLayout
        android:id="@+id/celebration_layer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/result_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingTop="@dimen/status_bar_pad"
        app:layout_constraintBottom_toTopOf="@+id/result_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg">

            <TextView
                android:id="@+id/txt_verdict"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.App.Verdict"
                android:textColor="@color/cream_50" />

            <TextView
                android:id="@+id/txt_result_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textColor="@color/cream_100" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_preview"
                android:layout_width="@dimen/preview_card"
                android:layout_height="@dimen/preview_card"
                android:layout_marginTop="@dimen/space_md"
                app:cardBackgroundColor="@color/board_fill"
                app:cardCornerRadius="@dimen/card_radius_md"
                app:cardElevation="12dp"
                app:strokeColor="#66FFCF56"
                app:strokeWidth="2dp">

                <com.SkQmTzV.nJxLpR.core.ui.JellyBoardView
                    android:id="@+id/preview_board"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/space_xxs" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/stars_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/star_one"
                    android:layout_width="@dimen/star_size"
                    android:layout_height="@dimen/star_size"
                    android:contentDescription="@string/cd_star"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sprite_star" />

                <ImageView
                    android:id="@+id/star_two"
                    android:layout_width="@dimen/star_size"
                    android:layout_height="@dimen/star_size"
                    android:layout_marginStart="@dimen/space_sm"
                    android:contentDescription="@string/cd_star"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sprite_star" />

                <ImageView
                    android:id="@+id/star_three"
                    android:layout_width="@dimen/star_size"
                    android:layout_height="@dimen/star_size"
                    android:layout_marginStart="@dimen/space_sm"
                    android:contentDescription="@string/cd_star"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sprite_star" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/result_stats_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_md"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.SkQmTzV.nJxLpR.core.ui.StatCardView
                    android:id="@+id/result_stat_one"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <com.SkQmTzV.nJxLpR.core.ui.StatCardView
                    android:id="@+id/result_stat_two"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1" />

                <com.SkQmTzV.nJxLpR.core.ui.StatCardView
                    android:id="@+id/result_stat_three"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/result_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/nav_bar_pad"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_next"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_result_h"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/result_btn_next" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_again"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_result_h"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/result_btn_again" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_result_patterns"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_secondary_h"
                android:layout_weight="1"
                android:text="@string/result_btn_patterns" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_menu"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_secondary_h"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:text="@string/result_btn_menu" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
