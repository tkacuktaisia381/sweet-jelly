<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.App.Hero" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.10</item>
    </style>

    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="TextAppearance.App.Verdict" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TextAppearance.App.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.App.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.20</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.26</item>
    </style>

    <style name="TextAppearance.App.Numeral" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/jelly_pink</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:minHeight">@dimen/btn_primary_h</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:elevation">10dp</item>
        <item name="android:stateListAnimator">@animator/press_pop</item>
        <item name="android:outlineSpotShadowColor">@color/jelly_pink_deep</item>
        <item name="android:outlineAmbientShadowColor">@color/jelly_pink_deep</item>
        <item name="iconTint">@color/white</item>
        <item name="iconSize">@dimen/icon_size</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/space_sm</item>
        <item name="cornerRadius">30dp</item>
        <item name="rippleColor">@color/ripple_light</item>
    </style>

    <style name="Widget.App.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/secondary_fill</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/secondary_stroke</item>
        <item name="android:textColor">@color/grape_500</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:minHeight">@dimen/btn_secondary_h</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@animator/press_pop</item>
        <item name="iconTint">@color/grape_500</item>
        <item name="iconSize">@dimen/icon_size</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/space_xs</item>
        <item name="cornerRadius">24dp</item>
        <item name="rippleColor">@color/secondary_stroke</item>
    </style>

    <style name="Widget.App.Button.IconOnly" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">@dimen/icon_btn</item>
        <item name="android:minHeight">@dimen/icon_btn</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconSize">@dimen/icon_size</item>
        <item name="iconTint">@color/cream_50</item>
        <item name="iconPadding">0dp</item>
        <item name="rippleColor">@color/ripple_light</item>
    </style>

    <style name="Widget.App.Card.Clay" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/card_radius_md</item>
        <item name="cardElevation">14dp</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/sheet_stroke</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>
</resources>
